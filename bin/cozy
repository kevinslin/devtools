#!/usr/bin/env bash
set -euo pipefail

devtools_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
cozy_source="${devtools_root}/src/cozy"
cozy_cache="${XDG_CACHE_HOME:-${HOME}/.cache}/devtools/cozy"
cozy_binary="${cozy_cache}/cozy"
cozy_build_tmp=""

cleanup_cozy_build() {
    if [[ -n "${cozy_build_tmp}" && -f "${cozy_build_tmp}" ]]; then
        rm -f -- "${cozy_build_tmp}"
    fi
}

if [[ ! -f "${cozy_source}/go.mod" ]]; then
    printf 'cozy: Go source module not found at %s\n' "${cozy_source}" >&2
    exit 1
fi

if [[ ! -x "${cozy_binary}" ]] ||
    [[ -n "$(find "${cozy_source}" -type f \( -name '*.go' -o -name 'go.mod' \) -newer "${cozy_binary}" -print -quit 2>/dev/null)" ]]; then
    if ! command -v go >/dev/null 2>&1; then
        printf 'cozy: Go is required to build %s\n' "${cozy_source}" >&2
        exit 1
    fi

    mkdir -p -- "${cozy_cache}"
    cozy_build_tmp="$(mktemp "${cozy_cache}/.cozy.XXXXXXXX")"
    trap cleanup_cozy_build EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    chmod 700 "${cozy_build_tmp}"
    go -C "${cozy_source}" build -o "${cozy_build_tmp}" ./cmd/cozy
    mv -f -- "${cozy_build_tmp}" "${cozy_binary}"
    cozy_build_tmp=""
    trap - EXIT HUP INT TERM
fi

if [[ -z "${COZY_CONFIG+x}" ]]; then
    export COZY_CONFIG="${devtools_root}/config/cozy/config.yaml"
fi

exec "${cozy_binary}" "$@"
