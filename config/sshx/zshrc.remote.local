# Managed by sshx. Keep this overlay portable and credential-free.
typeset -g SSHX_ZSHRC_LOCAL_LOADED=1

[[ -o interactive ]] || return 0

# Shared interactive behavior.
setopt INC_APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
unsetopt BEEP
unsetopt HIST_BEEP
unsetopt LIST_BEEP
bindkey -v
bindkey '^R' history-incremental-search-backward
[[ -t 0 && -r "$HOME/.fzf.zsh" ]] && source "$HOME/.fzf.zsh"

# Portable aliases shared with remote development shells.
alias p='pnpm'
alias dexc='codex --profile xxhigh'
alias dexd='codex --profile dendron'
alias dexr='codex --profile research --search'
alias dex='codex --profile gen'
alias vim='nvim'
alias vo='${EDITOR:-vim} "$HOME/.zshrc.local"'
alias vc='${EDITOR:-vim} "$HOME/.codex/config.toml"'
alias k='kubectl'
alias tml='tmux list-sessions'
alias tma='tmux attach-session -t'
alias gb='git branch'
alias gd='git diff'
alias gbd='git branch --delete'
alias gs='git status'
alias gl='git log'
alias gco='git checkout'
