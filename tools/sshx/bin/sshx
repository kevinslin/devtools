#!/usr/bin/env python3
"""Sync local dotfiles to a remote host, then connect over SSH."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time


DEFAULT_CONFIG_PATH = Path(__file__).resolve().parents[1] / "config" / "config.yaml"
SSHX_CONFIG_ENV = "SSHX_CONFIG_PATH"
SSH_BIN_ENV = "SSHX_SSH_BIN"
RSYNC_BIN_ENV = "SSHX_RSYNC_BIN"
TAR_BIN_ENV = "SSHX_TAR_BIN"
RSYNC_RETRY_EXIT_CODE = 255
RSYNC_RETRY_DELAY_SECONDS = 1
RSYNC_REMOTE_CHECK_COMMAND = "command -v rsync >/dev/null 2>&1"
RSYNC_REMOTE_CHECK_TIMEOUT_SECONDS = 8
TAR_REMOTE_EXTRACT_COMMAND = 'mkdir -p "$HOME" && tar -xzf - -C "$HOME"'


def _build_parser(profile_names: tuple[str, ...]) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Sync a configured set of local dotfiles to a remote home directory "
            "with rsync or tar-over-ssh, then open an SSH session."
        )
    )
    parser.add_argument(
        "-i",
        "--identity-file",
        action="append",
        default=[],
        metavar="PATH",
        help="pass an SSH identity file to both rsync and ssh",
    )
    parser.add_argument(
        "-o",
        "--option",
        action="append",
        default=[],
        metavar="KEY=VALUE",
        help="pass an SSH -o option to both rsync and ssh",
    )
    parser.add_argument(
        "-p",
        "--port",
        metavar="PORT",
        help="pass a custom SSH port to both rsync and ssh",
    )
    parser.add_argument(
        "--profile",
        choices=profile_names,
        default="default",
        help="sync profile to use for default paths from tools/sshx/config/config.yaml",
    )
    parser.add_argument(
        "--path",
        action="append",
        default=[],
        metavar="RELATIVE_PATH",
        help="sync an additional home-relative path before connecting",
    )
    parser.add_argument(
        "--no-defaults",
        action="store_true",
        help="sync only the paths given via --path",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the sync and ssh commands without running them",
    )
    parser.add_argument(
        "--sync-method",
        choices=("auto", "rsync", "tar"),
        default="auto",
        help=(
            "sync with rsync, tar-over-ssh, or auto fallback from rsync to tar "
            "when remote rsync is unavailable"
        ),
    )
    parser.add_argument(
        "host",
        help="SSH destination, for example user@example.com",
    )
    parser.add_argument(
        "remote_command",
        nargs=argparse.REMAINDER,
        help="optional remote command to run after syncing",
    )
    return parser


def _profile_config_path() -> Path:
    raw = os.environ.get(SSHX_CONFIG_ENV)
    if raw:
        return Path(raw).expanduser().resolve()
    return DEFAULT_CONFIG_PATH


def _strip_yaml_comment(line: str) -> str:
    for index, char in enumerate(line):
        if char == "#" and (index == 0 or line[index - 1].isspace()):
            return line[:index]
    return line


def _unquote_yaml_scalar(raw: str) -> str:
    value = raw.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        return value[1:-1]
    return value


def _parse_profile_config(text: str) -> dict[str, tuple[str, ...]]:
    profiles: dict[str, list[str]] = {}
    in_profiles = False
    current_profile: str | None = None

    for line_number, line in enumerate(text.splitlines(), start=1):
        stripped = _strip_yaml_comment(line).rstrip()
        if not stripped.strip():
            continue

        indent = len(stripped) - len(stripped.lstrip(" "))
        if "\t" in stripped[:indent]:
            raise ValueError(f"line {line_number}: indentation must use spaces")

        content = stripped.strip()
        if indent == 0:
            if content == "profiles:":
                in_profiles = True
                current_profile = None
                continue
            raise ValueError(f"line {line_number}: expected top-level 'profiles:'")

        if not in_profiles:
            raise ValueError(f"line {line_number}: expected top-level 'profiles:'")

        if indent == 2 and content.endswith(":"):
            profile = _unquote_yaml_scalar(content[:-1])
            if not profile:
                raise ValueError(f"line {line_number}: profile name must not be empty")
            if profile in profiles:
                raise ValueError(f"line {line_number}: duplicate profile {profile!r}")
            profiles[profile] = []
            current_profile = profile
            continue

        if indent == 4 and content.startswith("- "):
            if current_profile is None:
                raise ValueError(f"line {line_number}: path entry must be under a profile")
            sync_path = _unquote_yaml_scalar(content[2:])
            if not sync_path:
                raise ValueError(f"line {line_number}: path entry must not be empty")
            profiles[current_profile].append(sync_path)
            continue

        raise ValueError(f"line {line_number}: unsupported config syntax")

    if not profiles:
        raise ValueError("profiles must define at least one profile")
    if "default" not in profiles:
        raise ValueError("profiles.default must be defined")
    empty_profiles = [name for name, paths in profiles.items() if not paths]
    if empty_profiles:
        raise ValueError(f"profile paths must not be empty: {', '.join(empty_profiles)}")

    return {name: tuple(paths) for name, paths in profiles.items()}


def _load_sync_profiles(config_path: Path) -> dict[str, tuple[str, ...]]:
    try:
        text = config_path.read_text(encoding="utf-8")
    except OSError as exc:
        raise ValueError(f"failed to read sshx config {config_path}: {exc}") from exc

    try:
        return _parse_profile_config(text)
    except ValueError as exc:
        raise ValueError(f"invalid sshx config {config_path}: {exc}") from exc


def _normalize_relative_path(raw: str, *, home: Path) -> Path:
    candidate = Path(raw).expanduser()
    if candidate.is_absolute():
        try:
            relative = candidate.relative_to(home)
        except ValueError as exc:
            raise ValueError(
                f"path must be inside {home}, got {candidate}"
            ) from exc
    else:
        relative = Path(raw)

    if relative == Path(".") or any(part == ".." for part in relative.parts):
        raise ValueError(f"path must stay inside the home directory, got {raw!r}")

    return relative


def _resolve_sync_paths(
    *,
    home: Path,
    include_defaults: bool,
    default_paths: tuple[str, ...],
    extra_paths: list[str],
) -> list[Path]:
    selected: list[Path] = []
    seen: set[str] = set()

    def add(relative: Path) -> None:
        key = relative.as_posix()
        if key in seen:
            return
        seen.add(key)
        selected.append(relative)

    if include_defaults:
        for raw in default_paths:
            relative = _normalize_relative_path(raw, home=home)
            if (home / relative).exists():
                add(relative)

    for raw in extra_paths:
        relative = _normalize_relative_path(raw, home=home)
        candidate = home / relative
        if not candidate.exists():
            raise ValueError(f"missing local path: {candidate}")
        add(relative)

    if not selected:
        raise ValueError(
            "no dotfiles selected; add files under your home directory or pass --path"
        )

    return selected


def _ssh_binary() -> str:
    return os.environ.get(SSH_BIN_ENV, "ssh")


def _rsync_binary() -> str:
    return os.environ.get(RSYNC_BIN_ENV, "rsync")


def _tar_binary() -> str:
    return os.environ.get(TAR_BIN_ENV, "tar")


def _ssh_command(
    *,
    identity_files: list[str],
    options: list[str],
    port: str | None,
) -> list[str]:
    command = [_ssh_binary()]
    for identity in identity_files:
        command.extend(["-i", identity])
    for option in options:
        command.extend(["-o", option])
    if port:
        command.extend(["-p", port])
    return command


def _ssh_no_stdin_command(ssh_base: list[str]) -> list[str]:
    return [ssh_base[0], "-n", *ssh_base[1:]]


def _trim_remote_command(remote_command: list[str]) -> list[str]:
    if remote_command and remote_command[0] == "--":
        return remote_command[1:]
    return remote_command


def _format_relative_rsync_path(path: Path) -> str:
    return f"./{path.as_posix()}"


def _format_relative_tar_path(path: Path) -> str:
    return path.as_posix()


def _build_rsync_command(
    *,
    ssh_base: list[str],
    sync_paths: list[Path],
    host: str,
) -> list[str]:
    return [
        _rsync_binary(),
        "-az",
        "--relative",
        "-e",
        shlex.join(ssh_base),
        *[_format_relative_rsync_path(path) for path in sync_paths],
        f"{host}:~/",
    ]


def _build_tar_create_command(*, sync_paths: list[Path]) -> list[str]:
    return [
        _tar_binary(),
        "-czf",
        "-",
        *_tar_metadata_flags(),
        "--",
        *[_format_relative_tar_path(path) for path in sync_paths],
    ]


def _build_tar_extract_command(*, ssh_base: list[str], host: str) -> list[str]:
    return [
        *ssh_base,
        host,
        TAR_REMOTE_EXTRACT_COMMAND,
    ]


def _tar_metadata_flags() -> list[str]:
    if sys.platform == "darwin":
        return ["--no-xattrs", "--no-mac-metadata"]
    return []


def _tar_environment() -> dict[str, str]:
    env = os.environ.copy()
    env["COPYFILE_DISABLE"] = "1"
    return env


def _run_rsync_sync(*, rsync_command: list[str], home: Path) -> int | None:
    try:
        rsync_result = subprocess.run(
            rsync_command,
            cwd=home,
            check=False,
        )
    except OSError as exc:
        print(f"warning: failed to run rsync: {exc}", file=sys.stderr)
        return None
    if rsync_result.returncode == RSYNC_RETRY_EXIT_CODE:
        print(
            (
                "warning: rsync lost the SSH transport (exit code 255); "
                "retrying once..."
            ),
            file=sys.stderr,
        )
        time.sleep(RSYNC_RETRY_DELAY_SECONDS)
        try:
            rsync_result = subprocess.run(
                rsync_command,
                cwd=home,
                check=False,
            )
        except OSError as exc:
            print(f"warning: failed to run rsync: {exc}", file=sys.stderr)
            return None
    return rsync_result.returncode


def _remote_rsync_available(*, ssh_base: list[str], host: str) -> bool | None:
    try:
        result = subprocess.run(
            [*_ssh_no_stdin_command(ssh_base), host, RSYNC_REMOTE_CHECK_COMMAND],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=RSYNC_REMOTE_CHECK_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired:
        print(
            "warning: remote rsync check timed out; falling back to tar-over-ssh sync",
            file=sys.stderr,
        )
        return False
    except OSError as exc:
        print(f"warning: failed to check remote rsync: {exc}", file=sys.stderr)
        return None

    if result.returncode == 0:
        return True
    if result.returncode in (1, 127):
        print(
            "warning: remote rsync unavailable; falling back to tar-over-ssh sync",
            file=sys.stderr,
        )
        return False
    return None


def _run_tar_sync(
    *,
    tar_create_command: list[str],
    tar_extract_command: list[str],
    home: Path,
) -> int:
    try:
        tar_process = subprocess.Popen(
            tar_create_command,
            cwd=home,
            env=_tar_environment(),
            stdout=subprocess.PIPE,
        )
    except OSError as exc:
        print(f"error: failed to run tar: {exc}", file=sys.stderr)
        return 1

    assert tar_process.stdout is not None
    try:
        ssh_result = subprocess.run(
            tar_extract_command,
            stdin=tar_process.stdout,
            check=False,
        )
    except OSError as exc:
        tar_process.stdout.close()
        tar_process.wait()
        print(f"error: failed to run ssh for tar sync: {exc}", file=sys.stderr)
        return 1

    tar_process.stdout.close()
    tar_returncode = tar_process.wait()
    if ssh_result.returncode != 0:
        print(
            f"error: tar-over-ssh extract failed with exit code {ssh_result.returncode}",
            file=sys.stderr,
        )
        return ssh_result.returncode
    if tar_returncode != 0:
        print(
            f"error: tar archive creation failed with exit code {tar_returncode}",
            file=sys.stderr,
        )
        return tar_returncode
    return 0


def _format_tar_pipeline(
    *,
    tar_create_command: list[str],
    tar_extract_command: list[str],
) -> str:
    return f"{shlex.join(tar_create_command)} | {shlex.join(tar_extract_command)}"


def _run(argv: list[str]) -> int:
    try:
        profiles = _load_sync_profiles(_profile_config_path())
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    args = _build_parser(tuple(sorted(profiles))).parse_args(argv)
    home = Path.home()

    try:
        sync_paths = _resolve_sync_paths(
            home=home,
            include_defaults=not args.no_defaults,
            default_paths=profiles[args.profile],
            extra_paths=args.path,
        )
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    ssh_base = _ssh_command(
        identity_files=args.identity_file,
        options=args.option,
        port=args.port,
    )
    remote_command = _trim_remote_command(args.remote_command)

    rsync_command = _build_rsync_command(
        ssh_base=ssh_base,
        sync_paths=sync_paths,
        host=args.host,
    )
    tar_create_command = _build_tar_create_command(sync_paths=sync_paths)
    tar_extract_command = _build_tar_extract_command(
        ssh_base=ssh_base,
        host=args.host,
    )
    ssh_command = [*ssh_base, args.host, *remote_command]

    if args.dry_run:
        if args.sync_method in ("auto", "rsync"):
            print(shlex.join(rsync_command))
        if args.sync_method in ("auto", "tar"):
            print(
                _format_tar_pipeline(
                    tar_create_command=tar_create_command,
                    tar_extract_command=tar_extract_command,
                )
            )
        print(shlex.join(ssh_command))
        return 0

    synced = False
    if args.sync_method in ("auto", "rsync"):
        remote_rsync_available = True
        if args.sync_method == "auto":
            remote_rsync_available = _remote_rsync_available(
                ssh_base=ssh_base,
                host=args.host,
            )

        if remote_rsync_available is not False:
            rsync_returncode = _run_rsync_sync(
                rsync_command=rsync_command,
                home=home,
            )
            if rsync_returncode == 0:
                synced = True
            elif args.sync_method == "auto" and rsync_returncode in (None, 127):
                print(
                    "warning: rsync unavailable; falling back to tar-over-ssh sync",
                    file=sys.stderr,
                )
            else:
                if rsync_returncode is None:
                    return 1
                print(
                    f"error: rsync failed with exit code {rsync_returncode}",
                    file=sys.stderr,
                )
                return rsync_returncode

    if not synced:
        tar_returncode = _run_tar_sync(
            tar_create_command=tar_create_command,
            tar_extract_command=tar_extract_command,
            home=home,
        )
        if tar_returncode != 0:
            return tar_returncode

    try:
        ssh_result = subprocess.run(
            ssh_command,
            check=False,
        )
    except OSError as exc:
        print(f"error: failed to run ssh: {exc}", file=sys.stderr)
        return 1
    return ssh_result.returncode


def main() -> int:
    return _run(sys.argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
